# Copy this file to .env and fill in your own keys.
# Never commit the real .env file.

# Google Gemini key for the coaching agent (https://aistudio.google.com)
GEMINI_API_KEY=

# Roboflow key for hoop detection (https://roboflow.com, workspace settings)
ROBOFLOW_API_KEY=

# Optional: override the Gemini model used by the agent
# SHOTCOACH_MODEL=
