# Copy this file to .env and fill in your own keys.
# Never commit the real .env file.

# OpenAI API key for the coaching agent (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Provider for the shared coaching engine. Development defaults to openai.
# SHOTCOACH_PROVIDER=openai
# SHOTCOACH_MODEL=gpt-4.1-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Roboflow key for hoop detection (https://roboflow.com, workspace settings)
ROBOFLOW_API_KEY=

# Optional: override the OpenAI model used by the agent (default gpt-4.1-mini).
# The stronger reasoning model used in the Terra evaluation; it costs more per answer.
# OPENAI_MODEL=gpt-6.1-terra
# Optional reasoning effort for non-gpt-4 OpenAI models: low, medium (model default) or high.
# SHOTCOACH_REASONING_EFFORT=medium

# Optional local development trace. It logs coaching evidence and text on the server.
# SHOTCOACH_DEBUG=0

# Optional diagnostic rates in USD per million tokens. Replace these example rates with your rates.
# SHOTCOACH_MODEL_PRICING='{"gpt-4.1-mini":{"input":0.40,"cached_input":0.10,"output":1.60}}'
